{
  "name": "@openwallet-foundation/askar-nodejs",
  "version": "0.3.2",
  "license": "Apache-2.0",
  "description": "Nodejs wrapper for Askar",
  "main": "build/index",
  "source": "src/index",
  "homepage": "https://github.com/openwallet-foundation/askar-wrapper-javascript",
  "author": "Openwallet Foundation (https://github.com/openwallet-foundation)",
  "repository": {
    "type": "git",
    "url": "https://github.com/openwallet-foundation/askar-wrapper-javascript",
    "directory": "packages/askar-nodejs"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "build",
    "scripts"
  ],
  "scripts": {
    "types:check": "pnpm compile --noEmit",
    "build": "pnpm clean && pnpm compile",
    "clean": "rimraf -rf ./build",
    "compile": "tsc -p ./tsconfig.build.json",
    "install": "node scripts/install.js",
    "test:init": "ts-node tests/utils/initialize.ts",
    "test:cryptobox": "ts-node tests/cryptobox.test.ts",
    "test:error": "ts-node tests/error.test.ts",
    "test:joseEcdh": "ts-node tests/joseEcdh.test.ts",
    "test:storeRS": "ts-node tests/store.test.ts",
    "test:all": "ts-node src/test-runner.ts",
    "test:build": "ts-node src/build-test.ts",
    "test:unit": "ts-node src/unit-test.ts",
    "test:integration": "ts-node src/test-koffi.ts",
    "test:koffi": "pnpm test:all",
    "test:getCurrentError": "node scripts/test-getCurrentError.js",
    "test:getCurrentError:ts": "ts-node tests/getCurrentError.test.ts",
    "test:simple": "node scripts/simple-test.js",
    "test:keyRS": "ts-node tests/keys.test.ts",
    "test:keyGenerate:algorithm": "ts-node test-keyGenerate-algorithm.js",
    "test:logger:all": "ts-node test-logger-all.cjs",
    "test:logger": "ts-node test-logger-custom.cjs",
    "test:list": "ts-node test-entryListCount.js",
    "test:list:key-entry": "ts-node test-keyEntryList.js",
    "test:store": "ts-node test-store-functions.js",
    "test:scan": "ts-node test-scan-functions.js",
    "test:session-debug": "ts-node debug-session-start.js",
    "test:session": "ts-node test-session-functions-new.js",
    "test:jwk": "ts-node debug-jwk.js",
    "test:store-generate": "ts-node test-store-generate.js",
    "storeunit": "ts-node tests/store.unit.test.ts"
  },
  "dependencies": {
    "@openwallet-foundation/askar-shared": "workspace:*",
    "koffi": "^2.14.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "ts-node": "^10.9.2",
    "typescript": "catalog:"
  },
  "binary": {
    "version": "v0.4.1",
    "host": "https://github.com/openwallet-foundation/askar/releases/download",
    "packageName": "library-{platform}-{arch}.tar.gz"
  },
  "engines": {
    "node": ">= 18"
  }
}
